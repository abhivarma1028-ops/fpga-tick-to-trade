# ITCH data files — multi-GB, never commit
data/*.bin
data/*.gz
data/*.txt

# Vivado project + synthesis artifacts (machine-specific, regenerated by
# build/synth.tcl). The whole Vivado/ working dir is excluded; keep the
# reproducible inputs (rtl/top.xdc, build/synth.tcl).
Vivado/
build/*.dcp
build/*.bit
build/*.rpt
build/*.log
build/*.jou
*.jou
*.log
*.str
*.dcp
*.bit
*.ltx
*.xpr
**/.Xil/

# cocotb / sim
sim/__pycache__/
sim/results.xml
sim/transcript
sim/dump.fst
sim/dump.vcd
sim/*.wlf
sim/questa_run/
sim/verilator_run/
sim/sim_build/
sim/sim_build_cdc/
sim/sim_build_mc/
sim/sim_build_sc/

# packaged IP output (regenerated by ip/package_cdc_ips.tcl)
ip/cdc_repo/

# QuestaSim native-TB build artifacts (keep the .sv and .do sources)
sim/sv_tb/work/
sim/sv_tb/transcript
sim/sv_tb/modelsim.ini
sim/sv_tb/*.wlf
sim/sv_tb/vsim.wlf

# LaTeX intermediates (keep .tex and .pdf)
docs/*.aux
docs/*.out
docs/*.toc

# Local Claude Code config (not part of the project)
.claude/

# QuestaSim generated default config (Mentor proprietary; regenerated by vmap)
sim/modelsim.ini

# Python
__pycache__/
*.pyc
*.pyo
.venv/
cocotb-env/

# Overlay / bitstream (generated)
overlay/*.bit
overlay/*.hwh

# Jupyter checkpoints
.ipynb_checkpoints/

# AWS FPGA HDK vendor clone (1.4GB, own .git) — never commit; MM CL mirrored in f2/cl_market_maker/
aws-fpga/
# Vivado/Questa scratch + machine-local
.cxl/
.cxl.ip/
.cxl.questasim.version
*.bak
clockInfo.txt
modelsim.ini
vish_stacktrace.vstf
# transient live-monitor state (regenerated each run)
reports/run_state.json
# gate-level sim: generated simlibs/netlists/db (keep only *.tcl/*.sv/*.md sources)
gatesim/simlib/
gatesim/xsim.dir/
gatesim/*.sdf
gatesim/*.qdb
gatesim/*.wdb
gatesim/*.pb
gatesim/*.jou
gatesim/*.log
gatesim/xelab.*
gatesim/xvlog.*

# gate-level sim: the post-route netlists are Vivado output, ~4.6 MB each and
# regenerated by write_verilog. Keep tb_timesim*.sv, drop the netlists.
gatesim/*.v

# Vivado block-design / mc_top project: keep the .rpt evidence and the .tcl/.xdc
# sources, drop every regenerable binary. A .dcp is a full design checkpoint and
# routinely runs to several MB.
vivado/**/*.dcp
vivado/**/*.rpx
vivado/**/*.wdb
vivado/**/*.pb
vivado/**/*.jou
vivado/**/*.log
vivado/**/*.str
vivado/**/*.vds
vivado/**/*.dbg
vivado/**/.Xil/
vivado/**/*.cache/
vivado/**/*.hw/
vivado/**/*.ip_user_files/
vivado/**/*.sim/
vivado/**/*.gen/

# cocotb build dirs for the per-block testbenches
sim/sim_build_lat/
sim/sim_build_ofi/

# timestamped monitor backups (plain *.bak is already covered above)
reports/*.bak-*

# compile_simlib / impl console logs (the .rpt evidence is kept)
gatesim/*.stdout
